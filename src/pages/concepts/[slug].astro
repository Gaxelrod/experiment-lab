---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MetricRow from '../../components/MetricRow.astro';
import { STATUS_ORDER, STATUS_CONFIG } from '../../lib/status';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((concept) => ({
    params: { slug: concept.id },
    props: { concept },
  }));
}

const { concept } = Astro.props;
const { data } = concept;
const { Content } = await render(concept);

const contextFields = [
  { label: 'Audience', value: data.targetAudience },
  { label: 'Duration', value: data.duration },
  { label: 'Split', value: data.trafficSplit },
  { label: 'Platform', value: data.platform },
].filter((f) => f.value);

const formatDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Base title={data.title}>
  <div class="max-w-3xl mx-auto">
    <!-- Back link -->
    <a href="/" class="text-text-dim text-sm hover:text-text-muted transition-colors mb-6 inline-block">
      <span class="text-epcvip-yellow">←</span> Back to all concepts
    </a>

    <!-- Header -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <div class="relative" id="status-toggle">
          <button
            id="status-btn"
            data-slug={concept.id}
            data-status={data.status}
            class="inline-flex items-center gap-1.5 cursor-pointer group"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <StatusBadge type="status" value={data.status} />
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-dim group-hover:text-text-muted transition-colors" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div id="status-dropdown" class="absolute top-full left-0 mt-1 bg-epcvip-surface border border-epcvip-border rounded-lg shadow-lg py-1 z-50 hidden min-w-[140px]" role="listbox">
            {STATUS_ORDER.map((s) => (
              <button
                class="status-option w-full px-3 py-2 text-left text-sm flex items-center gap-2 hover:bg-epcvip-black/50 transition-colors"
                data-value={s}
                role="option"
              >
                <div class={`w-2 h-2 rounded-full ${STATUS_CONFIG[s].dotColor}`} />
                <span class={STATUS_CONFIG[s].textColor}>{STATUS_CONFIG[s].label}</span>
              </button>
            ))}
          </div>
        </div>
        {data.priority && <StatusBadge type="priority" value={data.priority} />}
      </div>
      <h1 class="font-heading font-bold text-[28px] leading-[1.2] text-text-primary mb-2">
        {data.title}
      </h1>
      <p class="text-text-dim text-sm">
        Created {formatDate(data.created)} · Updated {formatDate(data.updated)} · <span class="text-text-muted">{data.tags.join(', ')}</span>
      </p>
    </div>

    <!-- Prototype Link -->
    {data.prototypeUrl && (
      <a
        href={data.prototypeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 bg-epcvip-yellow/10 border border-epcvip-yellow/30 rounded-md px-4 py-3 mb-4 text-epcvip-yellow text-sm font-semibold hover:bg-epcvip-yellow/15 transition-colors"
      >
        <span class="text-base">&#9654;</span>
        View Prototype
        <span class="text-text-dim text-xs font-normal ml-auto">Opens in new tab</span>
      </a>
    )}

    <!-- Hypothesis -->
    <div class="bg-epcvip-surface rounded-md p-4 mb-4 border-l-[3px] border-l-epcvip-yellow">
      <div class="font-heading font-semibold text-epcvip-yellow text-[9px] uppercase tracking-[1.2px] mb-2">
        Hypothesis
      </div>
      <p class="text-text-secondary text-base leading-relaxed">
        {data.hypothesis}
      </p>
    </div>

    <!-- Variants -->
    <div class:list={[
      'grid grid-cols-1 gap-3 mb-4',
      data.variants.length <= 3 ? 'sm:grid-cols-' + data.variants.length : 'sm:grid-cols-2',
    ]}>
      {data.variants.map((variant, i) => (
        <div class:list={[
          'bg-epcvip-surface rounded-md p-4',
          i === 0
            ? 'border border-epcvip-border'
            : 'border border-epcvip-yellow',
        ]}>
          <div class:list={[
            'font-heading font-semibold text-[9px] uppercase tracking-wider mb-2',
            i === 0 ? 'text-text-muted' : 'text-epcvip-yellow',
          ]}>
            {variant.name}
          </div>
          <p class="text-text-secondary text-sm leading-relaxed">
            {variant.description}
          </p>
          {variant.prototypeUrl && (
            <a
              href={variant.prototypeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'inline-flex items-center gap-1.5 mt-3 text-xs font-semibold transition-colors',
                i === 0 ? 'text-text-muted hover:text-text-secondary' : 'text-epcvip-yellow hover:text-epcvip-yellow/80',
              ]}
            >
              <span>&#9654;</span> View Prototype
            </a>
          )}
        </div>
      ))}
    </div>

    <!-- Success Metrics -->
    <div class="mb-4">
      <h2 class="font-heading font-semibold text-text-muted text-[9px] uppercase tracking-[1.2px] mb-3">
        Success Metrics
      </h2>
      <div class="flex flex-col gap-1">
        {data.successMetrics.map((metric) => (
          <MetricRow name={metric.name} target={metric.target} isPrimary={metric.isPrimary} />
        ))}
      </div>
    </div>

    <!-- Guardrails -->
    {data.guardrails && data.guardrails.length > 0 && (
      <div class="mb-4">
        <h2 class="font-heading font-semibold text-text-muted text-[9px] uppercase tracking-[1.2px] mb-3">
          Guardrails
        </h2>
        <div class="space-y-1">
          {data.guardrails.map((g) => (
            <p class="text-epcvip-red text-sm">
              <span class="text-epcvip-yellow">⚠</span> {g}
            </p>
          ))}
        </div>
      </div>
    )}

    <!-- Context metadata -->
    {contextFields.length > 0 && (
      <div class="flex flex-wrap gap-4 text-text-dim text-sm border-t border-epcvip-border pt-4 mb-8">
        {contextFields.map((field) => (
          <span>
            <span class="text-text-muted">{field.label}:</span> {field.value}
          </span>
        ))}
      </div>
    )}

    <!-- Markdown body -->
    <div class="prose prose-invert prose-sm max-w-none
      prose-headings:font-heading prose-headings:text-text-primary prose-headings:font-semibold
      prose-p:text-text-secondary prose-p:leading-relaxed
      prose-li:text-text-secondary
      prose-strong:text-text-primary
      prose-code:text-epcvip-yellow prose-code:bg-epcvip-surface prose-code:px-1 prose-code:rounded
      prose-a:text-epcvip-yellow prose-a:no-underline hover:prose-a:underline
      border-t border-epcvip-border pt-6">
      <Content />
    </div>
  </div>
</Base>

<script>
  const btn = document.getElementById('status-btn');
  const dropdown = document.getElementById('status-dropdown');
  const slug = btn?.dataset.slug;

  // Status badge styles (must match StatusBadge component)
  const styles: Record<string, { text: string; bg: string; label: string }> = {
    draft: { text: 'text-[#555555]', bg: 'bg-[rgba(85,85,85,0.15)] border border-[rgba(85,85,85,0.3)]', label: 'Draft' },
    ready: { text: 'text-[#F2C744]', bg: 'bg-[rgba(242,199,68,0.15)] border border-[rgba(242,199,68,0.3)]', label: 'Ready' },
    running: { text: 'text-[#c0892e]', bg: 'bg-[rgba(192,137,46,0.15)] border border-[rgba(192,137,46,0.3)]', label: 'Running' },
    complete: { text: 'text-[#2a6b3f]', bg: 'bg-[rgba(42,107,63,0.15)] border border-[rgba(42,107,63,0.3)]', label: 'Complete' },
    killed: { text: 'text-[#c04040]', bg: 'bg-[rgba(192,64,64,0.15)] border border-[rgba(192,64,64,0.3)]', label: 'Killed' },
  };

  // Load saved status
  const saved = localStorage.getItem(`status-${slug}`);
  if (saved && styles[saved]) {
    updateBadge(saved);
  }

  function updateBadge(status: string) {
    const badge = btn?.querySelector('span');
    if (!badge) return;
    const s = styles[status];
    badge.className = `inline-flex items-center px-2.5 py-0.5 rounded text-[9px] font-heading font-semibold uppercase tracking-wider ${s.text} ${s.bg}`;
    badge.textContent = s.label;
    btn!.dataset.status = status;
  }

  // Toggle dropdown
  btn?.addEventListener('click', () => {
    const open = !dropdown?.classList.contains('hidden');
    dropdown?.classList.toggle('hidden', open);
    btn.setAttribute('aria-expanded', String(!open));
  });

  // Select option
  document.querySelectorAll('.status-option').forEach((opt) => {
    opt.addEventListener('click', () => {
      const value = (opt as HTMLElement).dataset.value!;
      localStorage.setItem(`status-${slug}`, value);
      updateBadge(value);
      dropdown?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close on click outside
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('#status-toggle')) {
      dropdown?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
