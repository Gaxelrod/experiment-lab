---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import Swimlane from '../components/Swimlane.astro';
import { STATUS_ORDER } from '../lib/status';

const allConcepts = await getCollection('concepts');
const conceptsByStatus = STATUS_ORDER.map((status) => ({
  status,
  concepts: allConcepts.filter((c) => c.data.status === status),
}));
const total = allConcepts.length;
---

<Base>
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 pb-4 border-b border-epcvip-border">
    <div class="flex items-center gap-3">
      <div class="bg-epcvip-yellow text-epcvip-black font-heading font-extrabold text-xs px-2 py-1 rounded tracking-wider">
        EPCVIP
      </div>
      <h1 class="font-heading font-bold text-[28px] leading-[1.2] text-text-primary">
        Experiment Lab
      </h1>
      <span class="text-text-dim text-sm">{total} concepts</span>
    </div>
    <FilterBar />
  </header>

  {conceptsByStatus.map(({ status, concepts }) => (
    <Swimlane status={status} concepts={concepts} />
  ))}
</Base>

<script>
  // Apply localStorage status overrides to dashboard
  const borderColors: Record<string, string> = {
    draft: 'border-l-[#333333]',
    ready: 'border-l-[#F2C744]',
    running: 'border-l-[#c0892e]',
    complete: 'border-l-[#2a6b3f]',
    killed: 'border-l-[#c04040]',
  };

  const cards = document.querySelectorAll('.concept-card') as NodeListOf<HTMLElement>;
  cards.forEach(card => {
    const slug = card.dataset.slug;
    const originalStatus = card.dataset.status;
    const saved = localStorage.getItem(`status-${slug}`);

    if (saved && saved !== originalStatus) {
      // Remove from current swimlane
      const currentLane = card.closest('.swimlane') as HTMLElement;
      card.remove();

      // Find target swimlane
      const targetLane = document.querySelector(`.swimlane[data-status="${saved}"]`) as HTMLElement;
      if (targetLane) {
        const cardsContainer = targetLane.querySelector('.swimlane-cards');
        // Update card border color
        Object.values(borderColors).forEach(c => card.classList.remove(c));
        card.classList.add(borderColors[saved]);
        // Update opacity for draft
        card.classList.toggle('opacity-60', saved === 'draft');
        card.dataset.status = saved;
        cardsContainer?.appendChild(card);
        targetLane.style.display = '';
      }

      // Update counts and visibility
      document.querySelectorAll('.swimlane').forEach(lane => {
        const el = lane as HTMLElement;
        const count = el.querySelectorAll('.concept-card').length;
        const countEl = el.querySelector('.swimlane-count');
        if (countEl) countEl.textContent = `(${count})`;
        el.style.display = count === 0 ? 'none' : '';
      });
    }
  });
</script>
